# ============================================================
# 多Agent智能会议助手 - 环境变量配置模板
# ============================================================
# 使用方法: 复制本文件为 .env，填入真实凭证后即可
#   cp .env.example .env
# 主程序入口 src/main.py 会自动调用 load_dotenv() 加载
# ============================================================


# -------------------- 服务器配置 --------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=info


# -------------------- MiniMax LLM 配置 --------------------
# 获取方式: https://platform.minimaxi.com/ → 控制台 → API Keys
# 不配置时: SummaryAgent/ActionAgent/InsightAgent 会降级为规则引擎
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL=abab6.5s-chat


# -------------------- 飞书集成 --------------------
# 方式1: Webhook 机器人（推荐，最简单）
#   获取: 飞书群 → 设置 → 群机器人 → 添加机器人 → 复制 Webhook 地址
#   格式: https://open.feishu.cn/open-apis/bot/v2/hook/<UUID>
#   注意: <UUID> 部分就是 access token，必须完整且有效
FEISHU_WEBHOOK_URL=

# 方式2: 飞书应用（用于创建任务等高级功能）
#   获取: https://open.feishu.cn/app → 创建企业自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=


# -------------------- WhisperX 语音转写（可选） --------------------
# 不配置时: 使用内置演示转写数据
WHISPER_MODEL_SIZE=large-v2
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=zh

# pyannote-audio 说话人识别需要 HuggingFace token
# 获取: https://huggingface.co/settings/tokens
HF_TOKEN=
